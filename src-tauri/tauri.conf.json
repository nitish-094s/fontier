{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fontier",
  "version": "0.1.0",
  "identifier": "app.fontier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fontier",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0B0B0C",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Install, discover and manage fonts",
    "publisher": "Fontier",
    "copyright": "Copyright 2026 Fontier contributors",
    "category": "Productivity",
    "longDescription": "Fontier installs fonts in one go (files, zips or folders), browses about 2,000 free open-licensed families with live previews, manages everything installed, and can install new font downloads automatically from the tray.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Fontier",
        "compression": "lzma",
        "languages": [
          "English"
        ]
      }
    }
  },
  "mainBinaryName": "Fontier"
}